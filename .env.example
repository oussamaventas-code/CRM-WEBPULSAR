# ─────────────────────────────────────────────────────────────
# WEB PULSAR — variables de entorno
# Copia este archivo a .env (npm run setup lo hace por ti y genera las claves).
# Nunca subas .env a un repositorio.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
HOST=127.0.0.1
API_PORT=4000

# URL pública desde la que se usa la aplicación (en producción, https://...)
APP_URL=http://localhost:5173

# 1 si la app está detrás de Nginx/Cloudflare (necesario para IP real y rate limiting)
TRUST_PROXY=0

# Clave maestra AES-256-GCM (32 bytes en base64) para cifrar tokens y credenciales.
# Guárdala también FUERA del servidor: sin ella no se pueden descifrar los secretos de una copia de seguridad.
MASTER_KEY=

DATABASE_PATH=data/webpulsar.db
# Para producción, define DATABASE_URL con el connection string de Supabase (pooler en modo transaction).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=crm-documents
# Clave pública/anon del mismo proyecto para subir documentos directamente desde el navegador.
VITE_SUPABASE_ANON_KEY=
CRON_SECRET=
UPLOADS_DIR=data/uploads
BACKUPS_DIR=data/backups
BACKUP_KEEP=14
BACKUP_HOUR=3

SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# 0 desactiva monitorización, automatizaciones y copias programadas (útil en scripts)
SCHEDULER_ENABLED=1

# Web pública: orígenes (separados por comas) que pueden enviar el formulario a POST /api/public/leads
PUBLIC_FORM_ORIGINS=https://webpulsar.es,https://www.webpulsar.es
# Opcional: clave secreta de Cloudflare Turnstile; si está, el formulario debe enviar turnstileToken
TURNSTILE_SECRET_KEY=

# Opcional: tokens por variable de entorno (tienen prioridad sobre los guardados cifrados en la base de datos)
HOSTINGER_API_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Opcional: correo saliente (también configurable en Configuración → Integraciones)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
