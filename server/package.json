{
  "name": "@web-pulsar/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.js",
    "dev": "node --watch-path=src --disable-warning=ExperimentalWarning src/index.js",
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.js",
    "user:create": "node --disable-warning=ExperimentalWarning scripts/create-user.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
