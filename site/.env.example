# Variables PÚBLICAS de la web (acaban en el JavaScript del navegador). Nunca pongas secretos aquí.
# Copia a .env.production.local para compilar la versión de producción.

# URL del CRM. Vacío en desarrollo (Vite redirige /api al CRM local en 127.0.0.1:4000).
VITE_CRM_API_URL=https://crm.webpulsar.es

# Clave PÚBLICA (site key) de Cloudflare Turnstile. La secreta va solo en el .env del CRM (TURNSTILE_SECRET_KEY).
VITE_TURNSTILE_SITE_KEY=

VITE_SITE_URL=https://webpulsar.es

# true cuando el CRM tenga los endpoints de Stripe (GET /api/public/services, POST /api/public/checkout…).
# Mientras sea false, la web solo ofrece "Solicitar presupuesto" y no consulta al CRM.
VITE_CHECKOUT_ENABLED=false
