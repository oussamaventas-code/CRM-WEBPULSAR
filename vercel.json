{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/vercel.js",
      "functions": {
        "src/vercel.js": {
          "maxDuration": 60
        }
      }
    },
    "site": {
      "root": "site",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "buildCommand": "npm run build -- --base=/crm/",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "crons": [
    { "path": "/api/cron/monitoring", "schedule": "* * * * *" },
    { "path": "/api/cron/automations", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/integrations", "schedule": "0 * * * *" },
    { "path": "/api/cron/maintenance", "schedule": "15 * * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/crm",
      "destination": { "service": "web", "path": "/index.html" }
    },
    {
      "source": "/crm/",
      "destination": { "service": "web", "path": "/index.html" }
    },
    {
      "source": "/crm/:path*",
      "destination": { "service": "web", "path": "/:path*" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "site" }
    }
  ]
}
